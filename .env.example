# Database configuration (Defaults to SQLite for local development if not set)
# SQLite fallback: sqlite:///./buildwise.db
# PostgreSQL example: postgresql://username:password@localhost:5432/buildwise_db
DATABASE_URL=sqlite:///./buildwise.db

# AI & LLM configuration (Reserved for Phase 2 - Agents)
GEMINI_API_KEY=
LLM_PROVIDER=gemini

# Application Environment (development, testing, production)
APP_ENV=development

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
